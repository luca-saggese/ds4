$ make help 2>/dev/null || true
DS4 build targets:
  make cuda-spark          Build CUDA for DGX Spark / GB10
  make cuda-generic        Build CUDA for a generic local CUDA GPU
  make cuda CUDA_ARCH=sm_N Build CUDA with an explicit nvcc -arch value
  make strix-halo          Build ROCm for Strix Halo / gfx1151
  make rocm                Alias for make strix-halo
  make test-mxfp4-rocm     Build and run the synthetic ROCm MXFP4 MoE test
  make test-rocm           Core regression suite on ROCm-only hosts
  make cpu                 Build CPU-only ./ds4, ./ds4-server, ./ds4-bench, ./ds4-eval, and ./ds4-agent
  make test                Build and run tests
  make dspark-verify-depth Run DSpark speculative verification smoke if support GGUF is present
  make mtp-verify-depth    Run legacy MTP speculative verification smoke if MTP GGUF is present
  make clean               Remove build outputs

